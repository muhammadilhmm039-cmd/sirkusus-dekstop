            <textField><reportElement x="652" y="4" width="150" height="18"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
    <summary>
        <band height="26">
            <textField><reportElement x="0" y="6" width="802" height="18"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Total pendaftaran: " + $V{REPORT_COUNT}]]></textFieldExpression></textField>
