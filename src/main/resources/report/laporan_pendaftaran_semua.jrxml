<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pendaftaran_semua" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <queryString>
        <![CDATA[SELECT
    p.id_pendaftaran,
    p.tanggal_daftar,
    p.status AS status_pendaftaran,
    ps.nim,
    ps.nama AS nama_peserta,
    ps.prodi,
    ps.no_hp,
    kls.nama_kelas,
    krs.kode_kursus,
    krs.nama_kursus,
    krs.level,
    krs.biaya,
    ins.nama AS nama_instruktur
FROM pendaftaran p
INNER JOIN peserta ps ON p.id_peserta = ps.id_peserta
INNER JOIN kelas kls ON p.id_kelas = kls.id_kelas
INNER JOIN kursus krs ON kls.id_kursus = krs.id_kursus
INNER JOIN instruktur ins ON kls.id_instruktur = ins.id_instruktur
ORDER BY p.id_pendaftaran]]>
    </queryString>
    <field name="id_pendaftaran" class="java.lang.Integer"/>
    <field name="tanggal_daftar" class="java.sql.Date"/>
    <field name="status_pendaftaran" class="java.lang.String"/>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_peserta" class="java.lang.String"/>
    <field name="prodi" class="java.lang.String"/>
    <field name="no_hp" class="java.lang.String"/>
    <field name="nama_kelas" class="java.lang.String"/>
    <field name="kode_kursus" class="java.lang.String"/>
    <field name="nama_kursus" class="java.lang.String"/>
    <field name="level" class="java.lang.String"/>
    <field name="biaya" class="java.math.BigDecimal"/>
    <field name="nama_instruktur" class="java.lang.String"/>
    <title>
        <band height="62">
            <staticText><reportElement x="0" y="4" width="802" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement><text><![CDATA[LAPORAN PENDAFTARAN KURSUS]]></text></staticText>
            <staticText><reportElement x="0" y="34" width="802" height="18"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="10"/></textElement><text><![CDATA[SIKURSUS Desktop - Pemrograman Berorientasi Objek]]></text></staticText>
            <line><reportElement x="0" y="58" width="802" height="1"/></line>
        </band>
    </title>
    <columnHeader>
        <band height="24">
            <staticText><reportElement mode="Opaque" x="0" y="0" width="40" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="40" y="0" width="70" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[NIM]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="110" y="0" width="140" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Peserta]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="250" y="0" width="110" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Kelas]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="360" y="0" width="170" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Kursus]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="530" y="0" width="120" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Instruktur]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="650" y="0" width="80" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Tanggal]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="730" y="0" width="72" height="24" backcolor="#DDEFE9"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="22">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="40" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{id_pendaftaran}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="40" y="0" width="70" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="110" y="0" width="140" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="250" y="0" width="110" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="360" y="0" width="170" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="530" y="0" width="120" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nama_instruktur}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" pattern="yyyy-MM-dd" isBlankWhenNull="true"><reportElement x="650" y="0" width="80" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{tanggal_daftar}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="730" y="0" width="72" height="22"/><box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{status_pendaftaran}]]></textFieldExpression></textField>
        </band>
    </detail>
